<style is:global>
  .logo-wrap { width: var(--logo-w); max-width: 100%; }
  .aid-logo { width: 100%; height: auto; color: var(--ink); overflow: visible; }

.aid-logo .aid-edge{stroke-dasharray:1;stroke-dashoffset:0;animation:aid-line 1.1s cubic-bezier(.2,.6,.3,1) both;animation-delay:var(--delay)}
.aid-logo .aid-node{transform-box:fill-box;transform-origin:center;animation:aid-node .65s cubic-bezier(.22,.7,.25,1) both;animation-delay:var(--delay)}
.aid-logo .aid-wordmark{animation:aid-type .85s ease .55s both}
.aid-logo .aid-tagline{animation:aid-type .85s ease .8s both}
.aid-logo .aid-pulse{stroke:var(--gold);stroke-dasharray:13 107;stroke-dashoffset:14;opacity:0;animation:aid-pulse 1.25s ease-in-out both;animation-delay:var(--pulse-delay)}
@keyframes aid-line{from{stroke-dashoffset:1;opacity:0}to{stroke-dashoffset:0;opacity:1}}
@keyframes aid-node{from{opacity:0;transform:scale(.7)}to{opacity:1;transform:scale(1)}}
@keyframes aid-type{from{opacity:0}to{opacity:1}}
@keyframes aid-pulse{0%{opacity:0;stroke-dashoffset:14}15%{opacity:.95}80%{opacity:.95}100%{opacity:0;stroke-dashoffset:-105}}
.aid-static .aid-node,.aid-static .aid-edge,.aid-static .aid-wordmark,.aid-static .aid-tagline{animation:none!important}
.aid-static .aid-pulse{display:none}
@media(prefers-reduced-motion:reduce){.aid-logo .aid-node,.aid-logo .aid-edge,.aid-logo .aid-wordmark,.aid-logo .aid-tagline{animation:none!important}.aid-logo .aid-pulse{display:none}}

  /* ---- light sweep (band masked by the logo shapes) ---- */
  .aid-sweep { mix-blend-mode: var(--sweep-blend); opacity: 0; }
  .aid-band { transform-box: view-box; transform: translateX(-160px); }
  [data-sweep='on'] .aid-sweep { animation: aid-sweep-fade 22s linear 3.8s 3 both; }
  [data-sweep='on'] .aid-band { animation: aid-sweep-move 22s cubic-bezier(.4,.05,.55,.95) 3.8s 3 both; }
  @keyframes aid-sweep-move { 0% { transform: translateX(-160px); } 18% { transform: translateX(560px); } 100% { transform: translateX(560px); } }
  @keyframes aid-sweep-fade { 0% { opacity: 0; } 3% { opacity: 1; } 15% { opacity: 1; } 18% { opacity: 0; } 100% { opacity: 0; } }
  @media (max-width: 720px) { .aid-sweep { display: none; } }
  @media (prefers-reduced-motion: reduce) { .aid-sweep { display: none; } }
</style>
