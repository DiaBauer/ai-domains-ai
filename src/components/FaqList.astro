---
import { FAQ } from '../i18n/faq';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; limit?: number }
const { lang, limit = FAQ.length } = Astro.props;
---
<div class="faq-list">
  {FAQ.slice(0, limit).map((f) => (
    <details class="faq">
      <summary>{f.q[lang]}</summary>
      <div class="a"><p>{f.a[lang]}</p></div>
    </details>
  ))}
</div>
