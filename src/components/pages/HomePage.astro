---
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import DomainCard from '../DomainCard.astro';
import SectionHead from '../SectionHead.astro';
import EvidenceList from '../EvidenceList.astro';
import BundleCards from '../BundleCards.astro';
import FaqList from '../FaqList.astro';
import { homeFeatured, inCategory } from '../../lib/domains';
import { CATEGORIES } from '../../i18n/categories';
import { ZONE_STATS } from '../../i18n/market';
import { localePath, type Lang } from '../../lib/i18n';
import { ui } from '../../i18n/ui';
import { SITE } from '../../config/site';
import { organization } from '../../lib/seo';
interface Props { lang: Lang }
const { lang } = Astro.props;
const featured = homeFeatured().filter((d) => !d.heroPick).slice(0, 6);
const T = lang === 'en'
  ? {
      title: 'Premium AI Domains for Sale — Curated Portfolio | AI-DOMAIN.AI',
      desc: 'A curated portfolio of 75 premium AI domains from the owner’s own inventory: .ai names and category terms for founders, companies and portfolios. Purchases via Sedo.',
      featK: 'Featured', featT: 'Names that <em>define</em> a category.', featL: 'A selection from the portfolio. Every domain has its own page with use cases, buyer profiles and the Sedo purchase path.',
      catK: 'Categories', catT: 'Seven naming spaces.', catL: 'From core AI terms to agents, conversational AI, finance, health, business and education.',
      whyK: 'Why the name matters', whyT: 'A category name is a <em>brand asset</em>.',
      why1: 'Investors, talent and early customers read a domain as a signal of what a company is about. A category name buys clarity that would otherwise take years of marketing — it says the product before the pitch deck does.',
      why2: 'Premium domains are digital brand assets with an established resale market. Publicly reported sales show what buyers pay for category-defining names; every price on this site is an asking price, not a valuation and not a forecast.',
      whyBtn: 'Market evidence',
      evK: 'Documented market evidence', evT: 'What .ai domains have <em>actually</em> sold for.', evL: 'Publicly reported sales with date, venue and source. Individual sales are not averages; past sales are not a forecast.',
      bK: 'Bundles', bT: 'Domains that <em>belong together</em>.', bL: 'Whoever takes a name should take the adjacent spellings — otherwise the confusion belongs to someone else tomorrow.',
      hK: 'How buying works', hT: 'Handled via <em>Sedo</em>.',
      steps: [
        ['Select', 'Choose a domain from the portfolio and open its Sedo offer page — or send an enquiry for names not yet listed.'],
        ['Buy or enquire', 'Buy Now domains are bought directly at Sedo at the listed EUR price. Purchases initiated through AI-DOMAIN.AI are handled securely via Sedo.'],
        ['Pay via Sedo', 'You pay into a neutral account provided by Sedo; Sedo releases the payment to the seller only after the domain has been transferred to you.'],
        ['Transfer', 'Sedo’s transfer service guides both parties. For common extensions Sedo states an average of one to ten business days, depending on the registrars involved.'],
      ],
      hBtn: 'The full process',
      fK: 'Finder', fT: 'Narrow the portfolio by <em>what you build</em>.', fL: 'Pick a use case and see the strongest names for it — a deterministic selector, not an AI.',
      faqK: 'Questions', faqT: 'Short <em>answers</em>.',
      cK: 'Contact', cT: 'A short message is <em>enough</em>.', cL: 'For pricing, payment options or questions about the transfer. We’ll get back to you as soon as possible.',
    }
  : {
      title: 'Premium-KI-Domains zum Verkauf — Kuratiertes Portfolio | AI-DOMAIN.AI',
      desc: 'Ein kuratiertes Portfolio von 75 Premium-KI-Domains aus dem eigenen Bestand: .ai-Namen und Kategoriebegriffe für Gründer, Unternehmen und Portfolios. Käufe über Sedo.',
      featK: 'Ausgewählt', featT: 'Namen, die eine Kategorie <em>definieren</em>.', featL: 'Eine Auswahl aus dem Portfolio. Jede Domain hat eine eigene Seite mit Anwendungsideen, Käuferprofilen und dem Sedo-Kaufweg.',
      catK: 'Kategorien', catT: 'Sieben Namensräume.', catL: 'Von KI-Kernbegriffen über Agenten, Conversational AI, Finanzen, Gesundheit, Wirtschaft bis Bildung.',
      whyK: 'Warum der Name zählt', whyT: 'Ein Kategoriename ist ein <em>Markenwert</em>.',
      why1: 'Investoren, Talente und erste Kunden lesen eine Domain als Signal dafür, worum es einem Unternehmen geht. Ein Kategoriename schafft Klarheit, die sonst Jahre an Marketing kostet — er sagt das Produkt, bevor das Pitch-Deck es tut.',
      why2: 'Premium-Domains sind digitale Markenwerte mit einem etablierten Sekundärmarkt. Öffentlich gemeldete Verkäufe zeigen, was Käufer für kategoriebestimmende Namen zahlen; jeder Preis auf dieser Seite ist ein Angebotspreis — keine Bewertung und keine Prognose.',
      whyBtn: 'Marktbelege',
      evK: 'Dokumentierte Marktbelege', evT: 'Was .ai-Domains <em>tatsächlich</em> erzielt haben.', evL: 'Öffentlich gemeldete Verkäufe mit Datum, Ort und Quelle. Einzelne Verkäufe sind keine Durchschnittswerte; vergangene Verkäufe sind keine Prognose.',
      bK: 'Pakete', bT: 'Domains, die <em>zusammengehören</em>.', bL: 'Wer einen Namen besetzt, sollte die naheliegenden Schreibweisen mitnehmen — sonst gehört die Verwechslung morgen jemand anderem.',
      hK: 'So funktioniert der Kauf', hT: 'Abgewickelt über <em>Sedo</em>.',
      steps: [
        ['Auswählen', 'Wählen Sie eine Domain aus dem Portfolio und öffnen Sie ihre Sedo-Angebotsseite — oder senden Sie eine Anfrage für noch nicht gelistete Namen.'],
        ['Kaufen oder anfragen', 'Sofortkauf-Domains kaufen Sie direkt bei Sedo zum gelisteten EUR-Preis. Käufe, die über AI-DOMAIN.AI initiiert werden, werden sicher über Sedo abgewickelt.'],
        ['Zahlung über Sedo', 'Sie zahlen auf ein von Sedo bereitgestelltes Konto; Sedo zahlt den Kaufpreis erst an die Verkäuferin aus, wenn die Domain auf Sie übertragen ist.'],
        ['Übertragung', 'Sedos Transfer-Service begleitet beide Seiten. Für gängige Endungen nennt Sedo durchschnittlich ein bis zehn Werktage, abhängig von den beteiligten Registraren.'],
      ],
      hBtn: 'Der vollständige Ablauf',
      fK: 'Finder', fT: 'Das Portfolio nach dem eingrenzen, <em>was Sie bauen</em>.', fL: 'Wählen Sie einen Anwendungsfall und sehen Sie die stärksten Namen dafür — ein deterministischer Selektor, keine KI.',
      faqK: 'Fragen', faqT: 'Kurze <em>Antworten</em>.',
      cK: 'Kontakt', cT: 'Eine kurze Nachricht <em>genügt</em>.', cL: 'Für Preisanfragen, Zahlungsoptionen oder Fragen zur Übertragung. Wir melden uns so bald wie möglich.',
    };
---
<Base lang={lang} title={T.title} description={T.desc} jsonld={[organization()]}>
  <Hero lang={lang} />

  <section class="section-tight" aria-labelledby="feat">
    <div class="shell">
      <div class="flex between mb-2">
        <SectionHead kicker={T.featK} title={T.featT} lead={T.featL} class="mb-0" />
        <a class="btn btn-secondary" href={localePath(lang, '/domains/')}>{ui(lang, 'cta.allDomains')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid-3">{featured.map((d) => <div class="rv"><DomainCard domain={d} lang={lang} /></div>)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="cats">
    <div class="shell">
      <SectionHead kicker={T.catK} title={T.catT} lead={T.catL} />
      <div class="grid grid-4 cats">
        {CATEGORIES.map((c) => {
          const n = inCategory(c.slug).length;
          return (
            <a class="card is-link cat rv" href={localePath(lang, `/categories/${c.slug}/`)}>
              <span class="kicker">{n} {lang === 'de' ? 'Domains' : 'domains'}</span>
              <h3>{c.name[lang]}</h3>
              <p class="muted small">{c.short[lang]}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section rule-top mesh" aria-labelledby="why">
    <div class="shell why">
      <div>
        <SectionHead kicker={T.whyK} title={T.whyT} />
        <p class="lead rv">{T.why1}</p>
        <p class="rv measure">{T.why2}</p>
        <a class="btn btn-tertiary rv" href={localePath(lang, '/market/')}>{T.whyBtn} →</a>
      </div>
      <div class="stats rv">
        {ZONE_STATS.map((s) => <div class="stat glass p"><b>{s.value}</b><span>{s.label[lang]}</span><i>{s.source[lang]}</i></div>)}
      </div>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="ev">
    <div class="shell">
      <SectionHead kicker={T.evK} title={T.evT} lead={T.evL} />
      <EvidenceList lang={lang} limit={4} />
      <p class="mt-2"><a class="btn btn-tertiary" href={localePath(lang, '/market/')}>{lang === 'de' ? 'Alle Belege und Quellen' : 'All evidence and sources'} →</a></p>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="bundles">
    <div class="shell">
      <SectionHead kicker={T.bK} title={T.bT} lead={T.bL} />
      <BundleCards lang={lang} limit={2} />
      <p class="mt-2"><a class="btn btn-secondary" href={localePath(lang, '/bundles/')}>{lang === 'de' ? 'Alle Pakete' : 'All bundles'} <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="how">
    <div class="shell">
      <SectionHead kicker={T.hK} title={T.hT} lead={SITE.sedo.standard[lang]} />
      <ol class="plain steps grid grid-4">
        {T.steps.map(([h, p], i) => (
          <li class="step rv"><span class="n">{i + 1}</span><h3>{h}</h3><p>{p}</p></li>
        ))}
      </ol>
      <p class="mt-2"><a class="btn btn-tertiary" href={localePath(lang, '/how-it-works/')}>{T.hBtn} →</a></p>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="finder">
    <div class="shell">
      <SectionHead kicker={T.fK} title={T.fT} lead={T.fL} />
      <div class="grid grid-4">
        {CATEGORIES.map((c) => (
          <a class="card is-link rv finder-opt" href={`${localePath(lang, '/domains/')}#finder-${c.slug}`}>
            <span class="kicker">{c.short[lang]}</span>
            <p>{c.useCase[lang]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="faq">
    <div class="shell faq-wrap">
      <SectionHead kicker={T.faqK} title={T.faqT} />
      <div><FaqList lang={lang} limit={4} /><p class="mt-1"><a class="btn btn-tertiary" href={localePath(lang, '/faq/')}>{lang === 'de' ? 'Alle Fragen' : 'All questions'} →</a></p></div>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="contact">
    <div class="shell contact-cta glass">
      <div>
        <div class="kicker">{T.cK}</div>
        <h2 set:html={T.cT} />
        <p class="lead">{T.cL}</p>
      </div>
      <a class="btn btn-primary" href={localePath(lang, '/contact/')}>{ui(lang, 'cta.enquire')} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
<style>
  .mb-0 { margin-bottom: 0; }
  .cat h3 { font-size: 1.3rem; margin: 10px 0 4px; }
  .cat p { margin: 0; }
  .why { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .why .stats { grid-template-columns: 1fr; }
  .stat.p { padding: 20px 22px; }
  .steps { counter-reset: s; }
  .step { position: relative; padding: 24px; border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); }
  .step .n { font-family: var(--font-display); color: var(--gold); font-size: 1.4rem; display: block; margin-bottom: 8px; }
  .step h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .step p { color: var(--ink-2); font-size: .93rem; margin: 0; }
  .finder-opt p { margin: 8px 0 0; color: var(--ink-2); }
  .faq-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 72px); }
  .contact-cta { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: clamp(28px, 4vw, 48px); flex-wrap: wrap; }
  .contact-cta h2 { margin-bottom: 8px; }
  .contact-cta .lead { margin: 0; }
  @media (max-width: 960px) { .why, .faq-wrap { grid-template-columns: 1fr; } }
</style>
