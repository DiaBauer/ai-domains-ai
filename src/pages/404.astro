---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found" description="The page you requested does not exist or has moved. Browse the AI-DOMAIN.AI portfolio of 75 premium AI domains instead." noindex={true}>
  <section class="section">
    <div class="shell tc">
      <div class="kicker">404</div>
      <h1>Page not found · <span lang="de">Seite nicht gefunden</span></h1>
      <p class="lead" style="margin:0 auto 24px">The page you requested does not exist or has moved. · <span lang="de">Die angeforderte Seite existiert nicht oder wurde verschoben.</span></p>
      <p class="flex" style="justify-content:center"><a class="btn btn-primary" href="/domains/">Browse the portfolio</a> <a class="btn btn-secondary" href="/de/domains/" lang="de" hreflang="de">Zum Portfolio</a></p>
    </div>
  </section>
</Base>
